# =============================================================
# Prescription Intelligence — Backend Environment Variables
#
# Copy this file to .env and fill in all required values.
# NEVER commit .env to source control.
# =============================================================


# -----------------------------------------------------------------
# DATABASE — PostgreSQL
# All four values are REQUIRED. The backend will refuse to start
# without them.
# -----------------------------------------------------------------

DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prescription_intelligence


# -----------------------------------------------------------------
# ENVIRONMENT
# Controls whether .env loading and SECRET_KEY enforcement apply.
# Development: ENVIRONMENT=development  (default if unset)
# Production:  ENVIRONMENT=production   (SECRET_KEY is REQUIRED)
# -----------------------------------------------------------------

ENVIRONMENT=development


# -----------------------------------------------------------------
# AUTHENTICATION — JWT
# A long random secret used to sign access tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# REQUIRED in production. Set ENVIRONMENT=production to enforce.
# -----------------------------------------------------------------

SECRET_KEY=replace-with-a-long-random-secret-key


# -----------------------------------------------------------------
# CORS — Allowed Frontend Origins
# Comma-separated list of origins allowed to make requests.
# In production: use your actual domain, not localhost.
# Default (development): http://localhost:3000,http://127.0.0.1:3000
# -----------------------------------------------------------------

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -----------------------------------------------------------------
# EMAIL SERVICE
# Required for email verification (registration, resend verification).
# All five values must be set together — omitting any one raises an
# error on the first registration attempt.
#
# Variable names used by the application (exact match required):
#   SMTP_HOST         — SMTP server hostname
#   SMTP_PORT         — SMTP server port (typically 587 for STARTTLS)
#   SMTP_USERNAME     — SMTP login username
#   SMTP_PASSWORD     — SMTP login password
#   SMTP_FROM_EMAIL   — From address shown to recipients
#   FRONTEND_URL      — Base URL of the frontend (used in verification emails)
# -----------------------------------------------------------------

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_EMAIL=noreply@example.com
# FRONTEND_URL=https://yourdomain.com


# -----------------------------------------------------------------
# UPLOADS
# Local upload directory. In production, consider object storage
# (e.g., S3, GCS) and update UPLOAD_DIR accordingly.
# The backend creates this directory automatically if it doesn't
# exist. Never serve this directory as a public static path.
# -----------------------------------------------------------------

# UPLOAD_DIR=/var/app/uploads


# -----------------------------------------------------------------
# RATE LIMITING
# Rate-limit storage backend.
# Defaults to memory:// (in-process) when this variable is unset.
# In-memory storage is suitable only for a single-process/local
# deployment. Configure Redis when running multiple backend workers
# or multiple backend instances so that rate-limit counters are
# shared across all processes.
# -----------------------------------------------------------------

# RATELIMIT_STORAGE_URL=redis://redis:6379/0


# -----------------------------------------------------------------
# PRODUCTION NOTES
# -----------------------------------------------------------------
#
# 1. Run with:
#       uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 4
#
# 2. Use a process manager (systemd, gunicorn, Docker) in production.
#
# 3. Place behind a reverse proxy (nginx, Caddy) with TLS termination.
#
# 4. Set CORS_ORIGINS to your production frontend domain only.
#
# 5. Set SECRET_KEY to a strong unique value per environment.
#    Do not reuse the same SECRET_KEY in dev and production.
#
# 6. Run database migrations before starting:
#       alembic upgrade head
#
# 7. Tesseract must be installed on the server:
#       apt-get install tesseract-ocr
#
# 8. File storage: currently uses local filesystem (./uploads/).
#    For cloud deployments, replace UPLOAD_DIR or migrate to
#    an object storage backend (S3/GCS). The abstraction point
#    is backend/services/ocr_service.py + backend/main.py image endpoint.
#
# -----------------------------------------------------------------
